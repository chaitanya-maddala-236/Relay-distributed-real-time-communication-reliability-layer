RELAY_NODE_ID=relay-node-a
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
RELAY_REDIS_URL=redis://localhost:6379/0

RELAY_HEARTBEAT_INTERVAL_SECONDS=15
RELAY_HEARTBEAT_TIMEOUT_SECONDS=10
RELAY_SESSION_RESUME_WINDOW_SECONDS=300
RELAY_MESSAGE_RETENTION_SECONDS=300

RELAY_MAX_INFLIGHT_MESSAGES=100
RELAY_CONNECTION_QUEUE_MAX_MESSAGES=1000
RELAY_CONNECTION_QUEUE_MAX_BYTES=2000000
RELAY_MAX_MESSAGE_SIZE_BYTES=1000000
RELAY_PRESENCE_TTL_SECONDS=30
